ANTHROPIC_API_KEY=
HEARTVAR_DAILY_USD_BUDGET=     # per-UTC-day USD cap; AI degrades to evidence-only when hit (default 100.0; 0=off)
HEARTVAR_MODEL_PRICING=        # JSON override of the per-Mtok price table
HEARTVAR_MODEL=                # classification model (default claude-sonnet-4-6)
HEARTVAR_MAX_TOKENS=           # output cap (default 8000)
HEARTVAR_RESULT_MAX_TOKENS=    # result output cap (default 4000)
HEARTVAR_TEMPERATURE=          # sampling temperature (default 0.0)
HEARTVAR_CHAT_MODEL=           # /api/chat model (default claude-sonnet-4-6 — NOT haiku;
HEARTVAR_CHAT_MAX_TOKENS=      # /api/chat output cap (default 400)

HEARTVAR_RATE_PER_MIN=         # /api/curate per-IP limits, all windows must hold
HEARTVAR_RATE_PER_HOUR=        # (defaults 1000 / 1000 / 1000)
HEARTVAR_RATE_PER_DAY=
HEARTVAR_CHAT_RATE_PER_MIN=    # /api/chat per-IP limits (defaults 1000 / 1000 / 1000)
HEARTVAR_CHAT_RATE_PER_HOUR=
HEARTVAR_CHAT_RATE_PER_DAY=
HEARTVAR_GLOBAL_DAILY_CAP=     # max curations/UTC-day across all callers (0=off) — topology-independent backstop
HEARTVAR_429_ALERT_PER_MIN=    # loud ERROR log when 429s/60s exceed this (default 50)
HEARTVAR_MAX_OUTBOUND_CONCURRENCY=  # cap on simultaneous outbound DB connections (default 30)
HEARTVAR_REDIS_URL=            # shared Redis for the limiter (horizontal scaling); blank = in-process
HEARTVAR_TRUSTED_PROXY_IPS=
HEARTVAR_CLIENT_IP_HEADER=     # default x-azure-client-ip

HEARTVAR_OFFLINE_STRICT=       # 1 = offline-only (no live fallback except literature)
ALPHAMISSENSE_PATH=            # abs path to AlphaMissense_hg38.tsv.gz (Zenodo 8208688; 642,961,469 bytes, md5 9fd167735f16a1b87da6eb3e4c25fcb5). .tbi NOT on Zenodo: generate beside it with `tabix -s 1 -b 2 -e 2 <file>`
HEARTVAR_PHYLOP_PATH=          # absolute path to hg38.phyloP100way.bw (BP7 conservation; falls back to UCSC remote read if unset)
NCBI_API_KEY=                  # raises NCBI E-utilities 3→10 req/s
NCBI_EMAIL=
GTEX_DB_PATH=
OPENTARGETS_DB_PATH=           # offline Open Targets snapshot (scripts/build_opentargets_db.py); live GraphQL fallback if unset/absent
MEDGEN_DB_PATH=
MGI_DB_PATH=
UNIPROT_DB_PATH=
PANELAPP_SNAPSHOT_PATH=
GENCC_SNAPSHOT_PATH=           # offline GenCC snapshot (scripts/build_gencc_db.py -> backend/data, copied to mount); default reads in-image backend/data
CLINGEN_GV_PATH=               # offline ClinGen gene-validity JSON (scripts/build_clingen_gene_validity.py -> backend/data, copied to mount); default reads in-image backend/data
HEARTVAR_EREPO_TSV=
GNOMAD_CONSTRAINT_DB_PATH=
GNOMAD_FREQ_DB_PATH=
SPLICEAI_DB_PATH=
SPLICEAI_PANEL_BED_PATH=
CLINVAR_DB_PATH=
BIOGRID_DB_PATH=
FETAL_HEART_DB_PATH=

HEARTVAR_VEP_OFFLINE=          # 1/true/yes/on to enable the local fast-path (default off)
HEARTVAR_VEP_BINARY=          # vep executable (default "vep"; present in the app image)
HEARTVAR_VEP_DATA=            # --dir_cache: the installed cache dir (e.g. /app/data/vep)
HEARTVAR_VEP_FASTA=           # --fasta reference (optional, recommended for HGVS)
HEARTVAR_VEP_ASSEMBLY=        # --assembly (default GRCh38)
HEARTVAR_VEP_REVEL=           # tabixed REVEL data file → --plugin REVEL,<path> (PP3/BP4)
HEARTVAR_VEP_PLUGINS_DIR=     # --dir_plugins where REVEL.pm lives (e.g. /app/data/vep/Plugins)
HEARTVAR_VEP_EXTRA_ARGS=      # extra argv appended verbatim (e.g. --plugin CADD,…)
HEARTVAR_VEP_TIMEOUT=         # per-call subprocess timeout seconds (default 45)

HEARTVAR_ADMIN_EMAILS=        # e.g. alice@example.org,bob@example.org
HEARTVAR_LOGS_DIR=            # default: <project>/data/logs
